{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//typecheck": "必须显式指定 tsconfig.app.json —— 根 tsconfig.json 是 solution 配置(files:[])，直接 tsc --noEmit 不会检查任何文件",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify:sanitize": "node scripts/verify-sanitize.mjs"
  },
  "dependencies": {
