# ═══════════════════════════════════════════════════════
# easyStudy — 环境变量模板
# 复制为 .env 后填写实际值。.env 不提交到 Git。
#
# 方案B (混合模式):
#   应用进程通过 localhost 连接中间件
#   DB_HOST=localhost  REDIS_HOST=localhost  MINIO_ENDPOINT=localhost:9000
# ═══════════════════════════════════════════════════════

# ── 数据库 (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=easystudy
DB_USER=easystudy
DB_PASSWORD=change_me_in_production

# ── 缓存 (Redis) ──
REDIS_HOST=localhost
REDIS_PORT=6379
# 必填：Redis 口令。compose 用 --requirepass 启用，后端凭此连接。
# 生成方式: openssl rand -hex 16
REDIS_PASSWORD=change_me_in_production

# ── 文件存储 (MinIO) ──
MINIO_ENDPOINT=localhost:9000
MINIO_USER=easystudy_admin
MINIO_PASSWORD=change_me_in_production
# 可选：覆盖 compose 使用的 MinIO 镜像。上游 minio/minio 在 Docker Hub 已不可
# 匿名拉取（quay.io 同样 401），默认使用社区归档镜像维持可用性。
# MINIO_IMAGE=bitnamilegacy/minio:latest

# ── 中间件端口绑定 ──
# 默认 127.0.0.1：中间件只对本机可达。需要从其他机器直连时改为 0.0.0.0，
# 并自行确保有防火墙/网络隔离 —— Postgres/Redis/MinIO/Chroma 均无应用层鉴权。
# BIND_ADDR=127.0.0.1

# ── JWT ──
# 生成方式: openssl rand -hex 32  或在线生成 ≥256 位随机字符串
JWT_SECRET=generate_a_random_256bit_string_here

# ── DeepSeek API ──
# 必须带 /v1：OpenAI 兼容 SDK 会以 base_url 为前缀拼接 /chat/completions，
# 与 backend-ai/services/config.py 的默认值保持一致。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 讯飞星火 (TTS 语音合成) ──
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# ── 前端 ──
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 邮件 (SMTP) ──
# 以 QQ 邮箱为例: 设置 → 账户 → POP3/SMTP 服务 → 开启 → 获取授权码
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_admin_email@qq.com
MAIL_PASSWORD=your_smtp_authorization_code
# 注意: 当前实现从 spring.mail.username 取发件人，MAIL_FROM 仅供文档参考
MAIL_FROM=your_admin_email@qq.com

# ── Embedding 配置 ──
# chroma-builtin: ChromaDB 内置 ONNX 模型 (all-MiniLM-L6-v2, 免费)
# api:            OpenAI 兼容 Embedding API
EMBEDDING_BACKEND=chroma-builtin
# EMBEDDING_MODEL=text-embedding-3-small       # api 模式下的模型名
# EMBEDDING_API_KEY=                           # 默认复用 DEEPSEEK_API_KEY
# EMBEDDING_BASE_URL=https://api.openai.com/v1 # 默认复用 DEEPSEEK_BASE_URL

# ── Spring Boot ──
SPRING_PROFILES_ACTIVE=dev
